<?xml version="1.0" encoding="utf-8"?>
<!-- PSYCO · ícone transparente · esconde o ícone do system splash Android
     12+ · usuário vê apenas o background deep navy (igual o Compose splash)
     enquanto o Activity inicializa · transição visualmente perfeita. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
